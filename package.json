{
  "name": "modulo-escape",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gen:dump": "tsx scripts/dump-level.ts",
    "assets:fetch": "NODE_USE_ENV_PROXY=1 tsx scripts/fetch-assets.ts",
    "assets:process": "NODE_USE_ENV_PROXY=1 tsx scripts/process-assets.ts",
    "postinstall": "patch-package",
    "robin:build": "tsx scripts/robin/build-robin.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "draco3dgltf": "^1.5.9",
    "eslint": "^10.14.0",
    "meshoptimizer": "^1.3.0",
    "patch-package": "^8.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
